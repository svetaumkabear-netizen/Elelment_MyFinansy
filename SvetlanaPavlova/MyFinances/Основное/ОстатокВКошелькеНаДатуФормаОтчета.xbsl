метод ПериодПриИзменении(Источник: ПолеВвода<Дата>, Событие: СобытиеПриИзменении<Дата>)
    ЗаполнитьОтчет(Событие.НовоеЗначение)
;

@Обработчик
метод ПослеСоздания()
    //Компоненты.Период.Значение = Дата.Сейчас().КонецМесяца().ДобавитьМесяцы(1).ДобавитьДни(2)
    Компоненты.Период.Значение = Дата.Сейчас().КонецМесяца().ДобавитьДни(2)
    ЗаполнитьОтчет(Компоненты.Период.Значение)
;

@Локально
метод ЗаполнитьОтчет(ДатаОтчета:Дата)
    знч прОтчет = Компоненты.ПросмотрОтчета.Отчет как ОстатокВКошелькеНаДату
    прОтчет.Параметры.Период = ДатаОтчета.КонецДня()
    прОтчет.Параметры.ТекущаяДата = Дата.Сейчас().КонецДня()
    Компоненты.ПросмотрОтчета.Обновить()   
;