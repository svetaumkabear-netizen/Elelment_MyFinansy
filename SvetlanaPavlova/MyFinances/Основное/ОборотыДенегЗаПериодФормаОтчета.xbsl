
@Обработчик
метод ПослеСоздания()
    //Компоненты.Период.Значение = Дата.Сейчас().КонецМесяца().ДобавитьМесяцы(1).ДобавитьДни(2)
    Компоненты.НачалоПериода.Значение = Дата.Сейчас().НачалоМесяца()
    Компоненты.КонецПериода.Значение = Дата.Сейчас().КонецМесяца()
    
    ЗаполнитьОтчет(Компоненты.НачалоПериода.Значение, Компоненты.КонецПериода.Значение)
;

@Локально
метод ЗаполнитьОтчет(НачалоПериода:Дата, КонецПериода:Дата)
    знч прОтчет = Компоненты.ПросмотрОтчета.Отчет как ОборотыДенегЗаПериод
    прОтчет.Параметры.НачалоПериода = НачалоПериода.НачалоДня()
    прОтчет.Параметры.КонецПериода = КонецПериода.КонецДня()
    Компоненты.ПросмотрОтчета.Обновить()   
;

метод НачалоПериодаПриИзменении(Источник: ПолеВвода<Дата>, Событие: СобытиеПриИзменении<Дата>)
    ЗаполнитьОтчет(Событие.НовоеЗначение, Компоненты.КонецПериода.Значение)
;

метод КонецПериодаПриИзменении(Источник: ПолеВвода<Дата>, Событие: СобытиеПриИзменении<Дата>)
   ЗаполнитьОтчет(Компоненты.НачалоПериода.Значение, Событие.НовоеЗначение)
;