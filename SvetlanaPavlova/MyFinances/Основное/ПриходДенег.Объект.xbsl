@Обработчик
метод ПослеЗаписи(До: ПриходДенег.Данные, ПараметрыЗаписи: ПриходДенег.ПараметрыЗаписи)
    
    ОтменаПроведения()
    
    если не ПометкаУдаления 

        знч НаборКошелек = новый Кошелек.НаборЗаписей()
        НаборКошелек.Фильтр.Установить(Регистратор = Ссылка)
        НаборКошелек.ДобавитьЗапись(
            Период = Дата, 
            ВидЗаписи = ВидЗаписиРегистраНакопления.Приход,
            Счет = Счет,
            Сумма = Сумма)
        НаборКошелек.Записать()

        знч НаборОборотыДенег = новый ОборотыДенег.НаборЗаписей()
        НаборОборотыДенег.Фильтр.Установить(Регистратор = Ссылка)
        НаборОборотыДенег.ДобавитьЗапись(
            Период = Дата,
            Счет = Счет,
            Категория = Категория,
            Сумма = Сумма
        )
        НаборОборотыДенег.Записать() 

    ;
;

@Локально
метод ОтменаПроведения(): ничто //любой метод возвращает значение некоторого типа
 
    знч ПустойНаборКошелек = новый Кошелек.НаборЗаписей()
    ПустойНаборКошелек.Фильтр.Установить(Регистратор = Ссылка)
    ПустойНаборКошелек.Записать() 
    
    знч ПустойНаборОборотыДенег = новый ОборотыДенег.НаборЗаписей()
    ПустойНаборОборотыДенег.Фильтр.Установить(Регистратор = Ссылка)
    ПустойНаборОборотыДенег.Записать() 
               
;